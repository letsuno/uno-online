{
  "name": "uno-online",
  "version": "0.14.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/letsuno/uno-online.git"
  },
  "packageManager": "pnpm@10.11.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mediasoup"
    ]
  },
  "scripts": {
    "test": "pnpm format:check && node --test scripts/release/release-scripts.test.mjs && pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "release:check": "node scripts/release/check-release.mjs",
    "release:notes": "node scripts/release/release-notes.mjs",
    "version:sync": "node -e \"const v=require('./package.json').version;require('child_process').execSync('pnpm -r exec npm pkg set version='+v,{stdio:'inherit'})\""
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
