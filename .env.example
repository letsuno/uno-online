# ============================================
# UNO Online - 配置文件
# 复制为 .env 后按需修改
# ============================================

# --- GitHub OAuth（DEV_MODE=true 时可不填）---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- 安全（生产环境必须替换；示例值会被服务端拒绝）---
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-chars

# --- Cloudflare Turnstile 人机验证（可选，不配则跳过验证）---
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAB...

# --- WebAuthn / Passkey（可选，不配则从请求自动推断）---
# WEBAUTHN_RP_NAME=UNO Online
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGIN=https://example.com
# 多域名用逗号分隔：WEBAUTHN_RP_ID=example.com, play.example.com

# --- 开发模式（true 时跳过 GitHub 登录，直接输入用户名；生产必须为 false）---
DEV_MODE=false

# --- 房间闲置清理（毫秒，默认 2 小时）---
ROOM_IDLE_TIMEOUT_MS=7200000

# --- 域名（必填，Caddy 自动申请 SSL）---
DOMAIN=example.com
# Caddy 站点地址（有域名时设为域名，本地开发设为 :80）
CADDY_SITE_ADDRESS=example.com

# --- 部署镜像通道 ---
# latest=最新正式版，beta=最新测试版，也可填写 vX.Y.Z[-beta.N] 锁定或回滚到精确版本
UNO_IMAGE_TAG=latest

# --- 端口 ---
# 本地开发使用 http://localhost:5173；生产部署改为 https://${DOMAIN}
CLIENT_URL=http://localhost:5173
PORT=3001
HTTP_PORT=80
HTTPS_PORT=443

# --- 数据库（SQLite 文件路径）---
DATABASE_PATH=uno.db

# --- Redis（生产必填；仅开发模式可留空并使用内存存储）---
# REDIS_URL=redis://redis:6379
# Compose 内置 Redis 的密码；设置后 REDIS_URL 也必须包含同一密码。
# REDIS_PASSWORD=
# 临时房间/游戏状态的 schema 代号。兼容发布保持不变；破坏性发布在排空旧房间后递增。
RUNTIME_SCHEMA_VERSION=1

# --- 服务器信息（服务器选择器展示）---
SERVER_NAME=UNO Online
SERVER_MOTD=欢迎来到 UNO Online！

# --- GitHub OAuth 网络代理（可选）---
# GITHUB_PROXY=http://127.0.0.1:7890

# --- Mumble 语音服务（Docker 部署用）---
MUMBLE_PORT=64738
MUMBLE_GATEWAY_PORT=64737
MUMBLE_SUPERUSER_PASSWORD=admin

# --- Mumble ICE 频道管理（服务端使用，可选）---
MUMBLE_ICE_ENABLED=false
MUMBLE_ICE_HOST=mumble
MUMBLE_ICE_PORT=6502
MUMBLE_ICE_SECRET=
MUMBLE_ICE_SERVER_ID=1
MUMBLE_ICE_PARENT_CHANNEL_ID=0
MUMBLE_CHANNEL_PREFIX="UNO "

# --- 社区 AI 插件（可选，仅在服务启动时加载）---
# 每个子目录包含 ai-plugin.json、strategy.ts，以及可选的 ONNX 文件
# 直接运行服务端时使用以下两个路径；Docker Compose 使用后面的宿主目录映射
# UNO_AI_PLUGINS_DIR=./data/ai-plugins
# 管理后台的启停状态会持久化到此文件
# UNO_AI_PLUGIN_SETTINGS_FILE=./data/ai-plugin-settings.json
# Docker Compose 宿主目录（容器内固定挂载到 /ai/plugins 与 /ai/state）
UNO_AI_PLUGINS_HOST_DIR=./data/ai-plugins
UNO_AI_PLUGIN_STATE_HOST_DIR=./data/ai-plugin-state
# 单次插件决策超时
UNO_AI_DECISION_TIMEOUT_MS=1500
# ONNX 执行后端：cpu / cuda / dml；指定后端不可用时直接报错，不隐式切换 CPU
UNO_RL_ONNX_EP=cpu
